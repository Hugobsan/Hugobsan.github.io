---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Offers from '../components/Offers.astro';
import Work from '../components/Work.astro';
import Experience from '../components/Experience.astro';
import How from '../components/How.astro';
import Side from '../components/Side.astro';
import Education from '../components/Education.astro';
import Contact from '../components/Contact.astro';
import Terminal from '../components/Terminal.astro';
import { LOCALES, LANGS, type Lang } from '../i18n';
import pt from '../i18n/pt';
import { SITE, EMAIL, GREENN, LINKEDIN, GITHUB, KNOWS_ABOUT, LANGUAGES } from '../facts';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang: lang === 'en' ? undefined : lang }, props: { lang } }));
}
interface Props { lang: Lang }
const { lang } = Astro.props;
const { dict: t, path, html } = LOCALES[lang];

const person = `${SITE}/#person`;
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': person,
      name: 'Hugo Barbosa Santos',
      alternateName: ['Hugobsan', 'Hugo Barbosa'],
      jobTitle: 'Tech Lead',
      worksFor: { '@type': 'Organization', name: 'Greenn', url: GREENN },
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'UNIMONTES', alternateName: 'Universidade Estadual de Montes Claros' },
      address: { '@type': 'PostalAddress', addressCountry: 'BR' },
      email: `mailto:${EMAIL}`,
      image: `${SITE}/og/en.png`,
      url: `${SITE}/`,
      sameAs: [LINKEDIN, GITHUB],
      knowsAbout: KNOWS_ABOUT,
      knowsLanguage: LOCALES.en.dict.contact.langs.map((l, i) => ({ '@type': 'Language', name: l.name, alternateName: LANGUAGES[i] })),
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      url: `${SITE}/`,
      name: 'Hugo Barbosa',
      inLanguage: LANGS.map((l) => LOCALES[l].html),
      publisher: { '@id': person },
    },
    {
      '@type': 'ProfilePage',
      '@id': `${SITE}${path}#page`,
      url: `${SITE}${path}`,
      name: t.meta.title,
      description: t.meta.description,
      inLanguage: html,
      isPartOf: { '@id': `${SITE}/#website` },
      mainEntity: { '@id': person },
    },
    // papers are written in Portuguese: the original title is the headline everywhere
    ...pt.edu.pubs.map((p, i) => ({
      '@type': 'ScholarlyArticle',
      headline: p.t,
      // translated title, without the "(in Portuguese)" note some locales add and the closing period
      ...(lang !== 'pt' && { alternativeHeadline: t.edu.pubs[i]!.t.replace(/(\s*[（(][^()（）]*[)）])?[.。]?$/, '') }),
      inLanguage: 'pt-BR',
      dateCreated: p.v.match(/\d{4}/)?.[0],
      author: { '@id': person },
    })),
  ],
};

// root only: a visitor who chose a language before (localStorage, set by the switcher) goes back to it.
// No browser-language detection: everyone else, bots included, gets English
const others = JSON.stringify(LANGS.filter((l) => l !== 'en'));
const redirect = `(function(){var l;try{l=localStorage.getItem("lang")}catch(e){}if(${others}.indexOf(l)>-1)location.replace("/"+l+"/"+location.search+location.hash)})()`;
---
<Base lang={lang} title={t.meta.title} description={t.meta.description} path={path} home>
  {lang === 'en' && <script is:inline slot="first" set:html={redirect} />}
  <Fragment slot="head" set:html={`<!--email_off--><script type="application/ld+json">${JSON.stringify(ld)}</script><!--/email_off-->`} />

  <a class="skip" href="#main">{t.skip}</a>
  <canvas id="signal" aria-hidden="true"></canvas>
  <div class="progress" aria-hidden="true"></div>
  <Nav lang={lang} />
  <div class="page">
    <main id="main" tabindex="-1">
      <Hero t={t} />
      <Offers t={t} />
      <Work t={t} />
      <Experience t={t} />
      <How t={t} />
      <Side t={t} />
      <Education t={t} />
      <Contact t={t} />
    </main>
    <footer class="footer wrap"><div class="container"><p>{t.footer}</p></div></footer>
    <Terminal t={t} lang={lang} />
  </div>
</Base>

<script>
  import { state } from '../scripts/state';
  import fabCss from '../styles/fab.css?inline';

  // language switch: same section in the other language, and the stored choice is what the root redirects to
  document.querySelectorAll<HTMLAnchorElement>('.lang a').forEach((a) =>
    a.addEventListener('click', () => {
      a.hash = location.hash;
      try { localStorage.setItem('lang', a.dataset.lang!); } catch { /* storage blocked: the choice just is not remembered */ }
    }),
  );

  // in-page links: smooth scroll (Lenis when active, CSS otherwise) and focus moves to the target,
  // so keyboard users carry on from the section they jumped to
  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
    const el = a && document.getElementById(a.hash.slice(1));
    if (!el || e.button || e.metaKey || e.ctrlKey || e.shiftKey) return;
    e.preventDefault();
    history.replaceState(null, '', a.hash);
    if (state.lenis) state.lenis.scrollTo(el); // honours scroll-padding-top, like scrollIntoView
    else el.scrollIntoView();
    if (!el.hasAttribute('tabindex')) el.tabIndex = -1;
    el.focus({ preventScroll: true });
  });

  // copy email: clipboard inside the click, fall back to selecting the text
  const btn = document.getElementById('copy')!;
  const email = document.getElementById('email')!;
  const status = document.getElementById('copy-status')!;
  const label = btn.textContent!;
  let timer = 0;
  const select = () => getSelection()?.selectAllChildren(email);
  btn.addEventListener('click', () => {
    const done = () => {
      btn.textContent = status.textContent = btn.dataset.copied!;
      btn.dataset.state = 'copied';
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        btn.textContent = label;
        status.textContent = '';
        delete btn.dataset.state;
      }, 2400);
    };
    navigator.clipboard ? navigator.clipboard.writeText(email.textContent!.trim()).then(done, select) : select();
  });

  // How: the sphere loads as the section comes near; before that, and without JS, the skills are a flat list of chips.
  // These loaders live here, not in their components: each component <script> would be one more request before first paint
  const how = document.getElementById('how')!;
  const io = new IntersectionObserver(([e]) => {
    if (!e!.isIntersecting) return;
    io.disconnect();
    import('../scripts/sphere').then((m) => m.init(how)).catch(() => {});
  }, { rootMargin: '300px 0px' });
  io.observe(how);

  // Terminal: the module and the locale's data load in parallel on the first sign of intent. The button does nothing
  // without JS, so JS shows it, with its styles (?inline: kept out of the page's inline CSS, see fx.ts).
  // A failed load is forgotten, so the next hover or click tries again.
  document.head.append(Object.assign(document.createElement('style'), { textContent: fabCss }));
  const fab = document.querySelector<HTMLButtonElement>('.term-fab')!;
  const dot = fab.querySelector('.term-fab__dot')!;
  const get = () => Promise.all([import('../scripts/terminal'), fetch(fab.dataset.src!).then((r) => r.json())])
    .catch(() => { ready = undefined; });
  let ready: ReturnType<typeof get> | undefined;
  const load = () => (ready ??= get());
  const open = (restored?: boolean) => load().then((r) => r && r[0].open(r[1], restored));
  try { if (localStorage.getItem('term-seen')) dot.remove(); } catch { /* storage blocked: the badge shows on every visit */ }
  fab.hidden = false;
  fab.addEventListener('pointerenter', load, { once: true });
  fab.addEventListener('focus', load, { once: true });
  fab.addEventListener('click', () => {
    dot.remove();
    try { localStorage.setItem('term-seen', '1'); } catch { /* not remembered */ }
    open();
  });
  // the terminal was open when /language switched the page: reopen it here
  try {
    if (sessionStorage.getItem('term-open')) {
      sessionStorage.removeItem('term-open');
      open(true);
    }
  } catch { /* storage blocked */ }

  // the 3D signal loads after the page is idle and motion on first use, never on the critical path;
  // reduced motion and a device without hardware WebGL2 get no 3D at all
  const noWebgl = () => document.documentElement.classList.add('no-webgl');
  const boot = () => {
    // WebGL2 renderer name, '' when unavailable. Probed in a worker first because creating a context on a
    // software rasterizer can block the main thread for a second; self-contained so it can be stringified.
    const renderer = (g: WebGL2RenderingContext | null) => {
      if (!g) return '';
      const info = g.getExtension('WEBGL_debug_renderer_info');
      return String(g.getParameter(info ? info.UNMASKED_RENDERER_WEBGL : g.RENDERER));
    };
    const probe = () => new Promise<string | null>((done) => {
      try {
        const src = `try{postMessage((${renderer})(new OffscreenCanvas(1,1).getContext('webgl2',{failIfMajorPerformanceCaveat:true})))}catch(e){postMessage(null)}`;
        const w = new Worker(URL.createObjectURL(new Blob([src], { type: 'text/javascript' })));
        w.onmessage = (e) => { w.terminate(); done(e.data); };
        w.onerror = () => { w.terminate(); done(null); };
      } catch { done(null); }
    });
    // a software rasterizer (blocklisted GPU, headless CI) would push 20k particles through the CPU
    const hardware = (name: string | null) => !!name && !/swiftshader|llvmpipe|software/i.test(name);

    const start = async () => {
      // pointer effects (custom cursor, click drizzle, the 3D ripple's click point), with or without the 3D
      import('../scripts/fx').then((m) => m.init()).catch(() => {});
      // everything motion drives is scroll-driven, so set it up at the first sign of use
      // (or right away when the page opens scrolled or on an anchor): phones never pay for it up front
      const setup = (onAnchor: boolean) => import('../scripts/motion').then((m) => m.init(onAnchor)).catch(() => {});
      const firstUse = () => {
        events.forEach((e) => removeEventListener(e, firstUse));
        setup(false);
      };
      const events = ['scroll', 'wheel', 'touchstart', 'pointermove', 'keydown'];
      if (scrollY > 0 || location.hash) setup(!!location.hash);
      else events.forEach((e) => addEventListener(e, firstUse, { passive: true }));
      // only a renderer the worker positively saw as software skips the main thread; '' or null
      // just means the worker can't tell (Safari < 17 has no WebGL in workers)
      const name = await probe();
      if (name && !hardware(name)) return noWebgl();
      const canvas = document.getElementById('signal') as HTMLCanvasElement;
      const gl = canvas.getContext('webgl2', { alpha: true, antialias: false, powerPreference: 'high-performance', failIfMajorPerformanceCaveat: true });
      if (gl && hardware(renderer(gl))) import('../scripts/signal').then((s) => s.init(canvas, gl)).catch(noWebgl);
      else noWebgl();
    };
    // after load and after a frame has been painted, when the main thread is idle
    const idle = () => requestAnimationFrame(() => setTimeout(() =>
      'requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 2500 }) : start()));
    if (document.readyState === 'complete') idle();
    else addEventListener('load', idle, { once: true });
  };
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  if (reduce.matches) reduce.addEventListener('change', boot, { once: true });
  else boot();

  // scroll progress: a CSS scroll-driven animation (global.css); browsers without one (Firefox) get it from here
  if (!CSS.supports('animation-timeline: scroll()')) {
    const bar = document.querySelector<HTMLElement>('.progress')!;
    let queued = 0;
    const paint = () => {
      queued = 0;
      const p = scrollY / Math.max(1, document.documentElement.scrollHeight - innerHeight);
      bar.style.transform = `scaleX(${Math.min(1, Math.max(0, p))})`;
    };
    addEventListener('scroll', () => { queued ||= requestAnimationFrame(paint); }, { passive: true });
    paint();
  }
</script>
