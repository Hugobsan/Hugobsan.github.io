---
import type { Dict } from '../i18n/en';
import NoBreak from './NoBreak.astro';
import Words from './Words.astro';
interface Props { t: Dict }
const { t } = Astro.props;
---
<section class="hero wrap" id="top" aria-labelledby="hero-h">
  <div class="container">
    <div class="hero__copy">
      <p class="hero__eyebrow">{t.hero.eyebrow}</p>
      <h1 id="hero-h"><Words text={t.hero.h1} cjk={t.cjk} /></h1>
      <p class="hero__sub"><NoBreak text={t.hero.sub} /></p>
      <div class="hero__ctas">
        <a class="btn btn--primary magnet" href="#contact">{t.hero.primary}</a>
        <a class="btn btn--ghost magnet" href="#work">{t.hero.secondary}</a>
      </div>
    </div>
  </div>
</section>
