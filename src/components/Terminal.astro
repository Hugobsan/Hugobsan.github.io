---
import type { Dict } from '../i18n/en';
import type { Lang } from '../i18n';
interface Props { t: Dict; lang: Lang }
const { t, lang } = Astro.props;
---
{/* only the button ships with the page (wired in the page script): terminal.ts builds the dialog from /terminal/{lang}.json on first use */}
<button class="term-fab magnet" type="button" aria-haspopup="dialog" aria-label={t.term.open} data-src={`/terminal/${lang}.json`} hidden>
  <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 7l5 5-5 5M13 17h6" /></svg>
  <span class="term-fab__dot"></span>
</button>
