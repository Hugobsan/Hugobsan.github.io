---
import type { Dict } from '../i18n/en';
import { CLUB, STACKS } from '../facts';
interface Props { t: Dict }
const { t } = Astro.props;
const { bluee, club, prp } = t.work;
const cases = [
  { id: 'bluee', c: bluee, stack: STACKS.bluee },
  { id: 'club', c: club, stack: STACKS.club, link: { href: CLUB, label: 'greenn.com.br/club' } },
  { id: 'panel-review', c: prp, stack: STACKS.prp, note: prp.note },
];
---
<section class="work" id="work" aria-labelledby="work-h">
  <div class="work__head wrap"><div class="container"><h2 class="h2" id="work-h">{t.work.h}</h2></div></div>
  <div class="stack">
    {cases.map(({ id, c, stack, link, note }) => (
      <article class="panel wrap" id={id} aria-labelledby={`${id}-t`}>
        <div class="container"><div class="panel__body">
          <h3 class="panel__title" id={`${id}-t`}>{c.name}</h3>
          {link && (
            <div class="panel__meta">
              <a class="ext" href={link.href} target="_blank" rel="noopener">{link.label}<span aria-hidden="true"> ↗</span></a>
            </div>
          )}
          {note && <div class="panel__meta"><span class="panel__note">{note}</span></div>}
          <p class="panel__lede">{c.lede}</p>
          <p class="panel__role">{c.role}</p>
          <p class="panel__hl"><strong>{c.highlight.n}</strong> <span>{c.highlight.l}</span></p>
          <ul class="bullets">{c.bullets.map((b) => <li>{b}</li>)}</ul>
          <ul class="chips" aria-label={t.work.stack}>{stack.map((s) => <li>{s}</li>)}</ul>
        </div></div>
      </article>
    ))}
  </div>
</section>
