---
import type { Dict } from '../i18n/en';
interface Props { t: Dict }
const { t } = Astro.props;
const top = t.edu.pubs.slice(0, 3);
const rest = t.edu.pubs.slice(3);
---
<section class="edu wrap" id="education" aria-labelledby="edu-h">
  <div class="container edu__grid">
    <div>
      <h2 class="h2" id="edu-h">{t.edu.h}</h2>
      <ol class="edu__list">
        {t.edu.items.map((e) => <li><strong>{e.t}</strong><span>{e.m}</span></li>)}
      </ol>
      <div class="edu__research">
        <h3 class="label">{t.edu.projectsH}</h3>
        <ol class="edu__list">
          {t.edu.projects.map((r) => <li><strong>{r.t}</strong><span>{r.m}</span></li>)}
        </ol>
      </div>
    </div>
    <div>
      <h2 class="h2">{t.edu.pubH}</h2>
      {t.edu.pubNote && <p class="pub__note">{t.edu.pubNote}</p>}
      <ol class="pubs">
        {top.map((p) => <li><span>{p.t}</span><span class="pub__venue">{p.v}</span></li>)}
      </ol>
      <details class="pubs__more">
        <summary>{t.edu.pubMore}</summary>
        <ol class="pubs" start={4}>
          {rest.map((p) => <li><span>{p.t}</span><span class="pub__venue">{p.v}</span></li>)}
          <li><span>{t.edu.manuscript.t}</span><span class="pub__venue">{t.edu.manuscript.v}</span></li>
        </ol>
      </details>
    </div>
  </div>
</section>
